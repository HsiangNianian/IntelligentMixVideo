      "segments": [
        {"text": "重大事件，","level": 1,"keyword": "","text_en": "A major event,","end_time": 0.96,"group_id": [1,6],"keyword_en": "","segment_id": 1,"start_time": 0.2},
        {"text": "上海瑞金医院","level": 2,"keyword": "上海瑞金医院","text_en": "Shanghai Ruijin Hospital","end_time": 2.44,"group_id": [2,6],"keyword_en": "Shanghai Ruijin Hospital","segment_id": 2,"start_time": 1.28},
        {"text": "刚刚装机的这台设备","level": 2,"keyword": "设备","text_en": "this device just installed","end_time": 4.16,"group_id": [3,6],"keyword_en": "device","segment_id": 3,"start_time": 2.44},
        {"text": "让全球医疗界集体失声，","level": 1,"keyword": "","text_en": "has left the global medical community speechless,","end_time": 6.52,"group_id": [4,6],"keyword_en": "","segment_id": 4,"start_time": 4.16},
        {"text": "中国造出了人类历史上","level": 1,"keyword": "","text_en": "China has built humanity's first","end_time": 8.9,"group_id": [5,6],"keyword_en": "","segment_id": 5,"start_time": 6.96},
        {"text": "第一台相控阵CT机。","level": 2,"keyword": "相控阵CT机","text_en": "phased-array CT scanner.","end_time": 11.16,"group_id": [6,6],"keyword_en": "phased-array CT scanner","segment_id": 6,"start_time": 8.9},
        {"text": "知道这意味着什么吗？","level": 1,"keyword": "","text_en": "Do you know what this means?","end_time": 12.72,"group_id": [1,1],"keyword_en": "","segment_id": 7,"start_time": 11.36},
        {"text": "这意味着我们","level": 1,"keyword": "","text_en": "It means that we","end_time": 14.064,"group_id": [1,5],"keyword_en": "","segment_id": 8,"start_time": 13.04},
        {"text": "在医疗影像领域","level": 1,"keyword": "","text_en": "in the field of medical imaging","end_time": 15.582,"group_id": [2,5],"keyword_en": "","segment_id": 9,"start_time": 14.064},
        {"text": "实现了维度碾压，","level": 1,"keyword": "","text_en": "have achieved a dimensional crushing victory,","end_time": 17.04,"group_id": [3,5],"keyword_en": "","segment_id": 10,"start_time": 15.582},
        {"text": "不是技术代差，","level": 1,"keyword": "","text_en": "not a generational technology gap,","end_time": 18.2,"group_id": [4,5],"keyword_en": "","segment_id": 11,"start_time": 17.28},
        {"text": "是物理原理的革命性突破。","level": 1,"keyword": "","text_en": "but a revolutionary breakthrough in physical principles.","end_time": 20.44,"group_id": [5,5],"keyword_en": "","segment_id": 12,"start_time": 18.44},
        {"text": "传统CT机","level": 2,"keyword": "传统CT机","text_en": "Traditional CT machines","end_time": 21.933,"group_id": [1,2],"keyword_en": "Traditional CT machines","segment_id": 13,"start_time": 20.8},
        {"text": "就像个老式唱片机，","level": 2,"keyword": "老式唱片机","text_en": "are like old-fashioned record players,","end_time": 23.56,"group_id": [2,2],"keyword_en": "old-fashioned record players","segment_id": 14,"start_time": 21.933},
        {"text": "靠着笨重的机械旋转","level": 1,"keyword": "","text_en": "relying on bulky mechanical rotation","end_time": 25.829,"group_id": [1,6],"keyword_en": "","segment_id": 15,"start_time": 23.8},
        {"text": "来扫描人体，","level": 2,"keyword": "人体","text_en": "to scan the human body,","end_time": 27.0,"group_id": [2,6],"keyword_en": "human body","segment_id": 16,"start_time": 25.829},
        {"text": "X射线灯泡和","level": 2,"keyword": "X射线灯泡","text_en": "with the X-ray tube and","end_time": 28.88,"group_id": [3,6],"keyword_en": "X-ray tube","segment_id": 17,"start_time": 27.4},
        {"text": "探测器的一圈圈转，","level": 2,"keyword": "探测器","text_en": "detectors spinning round and round,","end_time": 30.32,"group_id": [4,6],"keyword_en": "detectors","segment_id": 18,"start_time": 28.88},
        {"text": "转快了，","level": 1,"keyword": "","text_en": "spin too fast,","end_time": 31.36,"group_id": [5,6],"keyword_en": "","segment_id": 19,"start_time": 30.6},
        {"text": "扛不住离心力成像就模糊，","level": 1,"keyword": "","text_en": "they can't withstand the centrifugal force and the image blurs,","end_time": 33.72,"group_id": [6,6],"keyword_en": "","segment_id": 20,"start_time": 31.36},
        {"text": "肺部几毫米的小结节","level": 2,"keyword": "肺部","text_en": "small nodules of a few millimeters in the lungs","end_time": 35.686,"group_id": [1,6],"keyword_en": "lungs","segment_id": 21,"start_time": 33.92},
        {"text": "根本看不清。","level": 1,"keyword": "","text_en": "can't be seen clearly at all.","end_time": 36.6,"group_id": [2,6],"keyword_en": "","segment_id": 22,"start_time": 35.686},
        {"text": "这种旋转式扫描","level": 1,"keyword": "","text_en": "This rotational scanning","end_time": 38.3,"group_id": [3,6],"keyword_en": "","segment_id": 23,"start_time": 36.88},
        {"text": "已经统治医疗界50年了，","level": 1,"keyword": "","text_en": "has dominated the medical field for 50 years,","end_time": 40.24,"group_id": [4,6],"keyword_en": "","segment_id": 24,"start_time": 38.3},
        {"text": "但中国的相控阵CT","level": 2,"keyword": "相控阵CT","text_en": "but China's phased-array CT","end_time": 42.2,"group_id": [5,6],"keyword_en": "phased-array CT","segment_id": 25,"start_time": 40.48},
        {"text": "直接换道超车，","level": 1,"keyword": "","text_en": "has changed lanes and overtaken,","end_time": 43.52,"group_id": [6,6],"keyword_en": "","segment_id": 26,"start_time": 42.2},
        {"text": "彻底抛弃旋转结构，","level": 1,"keyword": "","text_en": "completely abandoning the rotating structure,","end_time": 45.38,"group_id": [1,2],"keyword_en": "","segment_id": 27,"start_time": 43.9},
        {"text": "改成静态双环设计。","level": 2,"keyword": "静态双环设计","text_en": "switching to a static dual-ring design.","end_time": 47.34,"group_id": [2,2],"keyword_en": "static dual-ring design","segment_id": 28,"start_time": 45.66},
        {"text": "更让人震惊的是，","level": 1,"keyword": "","text_en": "What's even more astonishing is,","end_time": 48.78,"group_id": [1,5],"keyword_en": "","segment_id": 29,"start_time": 47.5},
        {"text": "它的工作原理，","level": 1,"keyword": "","text_en": "its working principle:","end_time": 50.14,"group_id": [2,5],"keyword_en": "","segment_id": 30,"start_time": 49.06},
        {"text": "数百个X射线源和探测器","level": 2,"keyword": "X射线源和探测器","text_en": "hundreds of X-ray sources and detectors","end_time": 53.24,"group_id": [3,5],"keyword_en": "X-ray sources and detectors","segment_id": 31,"start_time": 50.46},
        {"text": "环绕成圈儿。","level": 1,"keyword": "","text_en": "arranged in a ring.","end_time": 54.34,"group_id": [4,5],"keyword_en": "","segment_id": 32,"start_time": 53.24},
        {"text": "通过精密的电子脉冲控制。","level": 1,"keyword": "","text_en": "Through precise electronic pulse control,","end_time": 56.42,"group_id": [5,5],"keyword_en": "","segment_id": 33,"start_time": 54.34},
        {"text": "在瞬间完成全方位扫描，","level": 1,"keyword": "","text_en": "it completes a full scan in an instant,","end_time": 59.14,"group_id": [1,3],"keyword_en": "","segment_id": 34,"start_time": 56.66},
        {"text": "就像被一群发光的蝴蝶环绕，","level": 2,"keyword": "发光的蝴蝶","text_en": "like being surrounded by a flock of glowing butterflies,","end_time": 61.94,"group_id": [2,3],"keyword_en": "glowing butterflies","segment_id": 35,"start_time": 59.5},
        {"text": "静静的却能洞察一切。","level": 1,"keyword": "","text_en": "silent yet able to see everything.","end_time": 64.22,"group_id": [3,3],"keyword_en": "","segment_id": 36,"start_time": 62.34},
        {"text": "这不是升级，","level": 1,"keyword": "","text_en": "This is not an upgrade,","end_time": 65.58,"group_id": [1,2],"keyword_en": "","segment_id": 37,"start_time": 64.42},
        {"text": "这是革命。","level": 1,"keyword": "","text_en": "this is a revolution.","end_time": 66.66,"group_id": [2,2],"keyword_en": "","segment_id": 38,"start_time": 65.82},
        {"text": "分辨率是传统CT的4倍，","level": 2,"keyword": "分辨率","text_en": "Resolution is 4 times that of traditional CT,","end_time": 69.3,"group_id": [1,2],"keyword_en": "Resolution","segment_id": 39,"start_time": 66.86},
        {"text": "扫描速度快3倍，","level": 1,"keyword": "","text_en": "scanning speed is 3 times faster,","end_time": 71.22,"group_id": [2,2],"keyword_en": "","segment_id": 40,"start_time": 69.7},
        {"text": "单次扫描信息量","level": 1,"keyword": "","text_en": "the amount of information per scan","end_time": 73.11,"group_id": [1,4],"keyword_en": "","segment_id": 41,"start_time": 71.71},
        {"text": "提升144倍，","level": 1,"keyword": "","text_en": "is increased 144 times,","end_time": 74.35,"group_id": [2,4],"keyword_en": "","segment_id": 42,"start_time": 73.11},
        {"text": "这等同于把肉眼","level": 1,"keyword": "","text_en": "this is equivalent to turning the naked eye","end_time": 76.19,"group_id": [3,4],"keyword_en": "","segment_id": 43,"start_time": 74.71},
