# 字段与 server/.env 按顺序对应；凭据和私有地址使用占位值，修改配置后重启服务。

# API 启动端口。
PORT=20070

# MySQL 连接；密码为占位值。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_me
DB_NAME=intelligent_mix_video

# 北京地域 Fun-ASR 密钥。
DASHSCOPE_API_KEY=

# 文案切片使用的 OpenAI 兼容模型服务。
IMV_LLM_BASE_URL=https://example.com/v1
IMV_LLM_API_KEY=
IMV_LLM_MODEL=
IMV_LLM_TIMEOUT_SECONDS=120
IMV_LLM_MAX_RETRIES=1

# 素材匹配服务；Authorization 按服务要求填写，无需鉴权时留空。
SEGMENT_MATCH_BASE_URL=https://matching.example.com
SEGMENT_MATCH_AUTHORIZATION=

# 视频合成回调的公网基础地址。
COMPOSITION_PUBLIC_BASE_URL=

# Remotion Agent 模型服务；填写实际地址、模型名称和密钥。
IMV_ACTOR_BASE_URL=https://example.com/v1
IMV_ACTOR_MODEL=
IMV_ACTOR_API_KEY=

# 视觉模型名称需单独填写；地址和密钥留空时复用 Agent 配置。
IMV_VISION_BASE_URL=
IMV_VISION_MODEL=
IMV_VISION_API_KEY=

# 仅在模型服务支持 thinking 扩展字段时设为 true。
IMV_DISABLE_THINKING=false

# 默认只记录用量，开启后才执行模型调用/token 配额。
IMV_ENFORCE_MODEL_BUDGET=false

# 单次输出上限始终生效。
IMV_MAX_OUTPUT_TOKENS=32000
IMV_MAX_TOKENS=200000
IMV_MAX_MODEL_CALLS=32

# 模型请求超时，单位秒。
IMV_MODEL_TIMEOUT_SECONDS=600

# Agent 任务与单次隔离渲染的独立超时，单位秒。
IMV_JOB_TIMEOUT_SECONDS=1800
IMV_RENDER_TIMEOUT_SECONDS=300

# 浏览器实际可执行文件；避免指向依赖额外路径的启动脚本。
IMV_BROWSER_EXECUTABLE=/opt/google/chrome/chrome

# 常规和粗体字体文件的绝对路径；以下为本机 Linux 安装位置。
IMV_FONT_REGULAR=/usr/share/fonts/noto-cjk/NotoSansCJK-Regular.ttc
IMV_FONT_BOLD=/usr/share/fonts/noto-cjk/NotoSansCJK-Bold.ttc

# 相对路径以 server/src/server/remotion_templates/ 为基准；只放任务草稿、读取缓存与私有审计，
# ZOS_BUCKET 为空时也存放封存版本、参考图与资产预览包。作品与任务记录在 MySQL，聊天历史在客户端本地。
IMV_DATA_DIR=.data

# 保留期限（天）：客户端未确认送达的事件、私有审计日志、设备不活跃后清理其会话数据。
IMV_UNDELIVERED_EVENT_DAYS=7
IMV_AUDIT_RETENTION_DAYS=14
IMV_DEVICE_RETENTION_DAYS=90

# 评审纠错、补证次数与连续无进展阈值。
IMV_MAX_REVIEW_RETRIES=2
IMV_MAX_EVIDENCE_RETRIES=1
IMV_MAX_NO_PROGRESS_TURNS=6

# 以下四个旧配额字段与 .env 保持对应；当前配置类未读取，填写后不生效。
IMV_MAX_JUDGE_CALLS=12
IMV_MAX_JUDGE_TOKENS=60000
IMV_MAX_ACTOR_CALLS=24
IMV_MAX_ACTOR_TOKENS=160000

# 上海 IMS 凭证；SecurityToken 仅用于临时 STS 凭证。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
MIX_VIDEO_ALIYUN_IMS_REGION_ID=cn-shanghai
MIX_VIDEO_ALIYUN_IMS_ENDPOINT=ice.cn-shanghai.aliyuncs.com

# 成片 MP4、PNG、透明 WebM 与 Remotion 封存文件的 ZOS 存储配置；输出地址须支持匿名读取。
# ZOS_BUCKET 留空时 Remotion 文件改存 IMV_DATA_DIR/objects；填写后其余字段必须完整。
ZOS_API_ENDPOINT=https://hangzhou7.zos.ctyun.cn
ZOS_BUCKET=
ZOS_ACCESS_KEY_ID=
ZOS_SECRET_ACCESS_KEY=
ZOS_WEB_URL=
ZOS_REGION=hangzhou-7
ZOS_FORCE_PATH_STYLE=false
