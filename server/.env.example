# OpenAI 兼容模型服务，三项缺一不可
IMV_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
IMV_LLM_MODEL=ark-code-latest
IMV_LLM_API_KEY=

# SDK 统一重试；0 表示禁用，默认最多重试一次
IMV_LLM_MAX_RETRIES=1

# 远程 HTTP 模型地址需显式开启，默认关闭
IMV_ALLOW_INSECURE_LLM_HTTP=false

# 片段时长与关键词约束
IMV_SEGMENT_MIN_DURATION_MS=1200
IMV_SEGMENT_MAX_DURATION_MS=6000
IMV_SEGMENT_MAX_KEYWORDS=5
IMV_SEGMENT_KEYWORD_MAX_LENGTH=12

# 对齐工作预算：候选状态、字符比较及单侧字符计数；超限立即终止
IMV_SEGMENT_MAX_ALIGNMENT_WORK=250000
IMV_SEGMENT_MAX_ASR_CHARS=20000
IMV_SEGMENT_MAX_ASR_WORDS=20000
