# 源码运行统一读取 server/.env，与启动目录无关；修改后重启服务。
# 优先级：构造参数 > 进程环境变量 > 本文件 > 字段默认值。

# API 启动端口；默认 20070，范围 1～65535，进程环境变量优先。
PORT=20070

# MySQL 连接；pydantic-settings 自动读取，进程环境变量优先于本文件。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_me
DB_NAME=intelligent_mix_video
# 可选 TLS CA；启用后驱动校验服务端证书。
# DB_SSL_CA=/path/to/mysql-ca.pem
# 可选 Unix socket；桌面内置服务自动设置，普通部署留空使用 TCP。
# DB_SOCKET=/path/to/mysql.sock

# 北京地域 Fun-ASR 密钥；模块加载时读取一次，进程环境变量优先。
DASHSCOPE_API_KEY=

# OpenAI 兼容模型服务；填写自己的 Key；字段名与 IMV_ 前缀保持不变
IMV_LLM_BASE_URL=https://example.com/v1
IMV_LLM_API_KEY=
IMV_LLM_MODEL=
IMV_LLM_TIMEOUT_SECONDS=120
IMV_LLM_MAX_RETRIES=1

# Local template agent credentials; copy to server/.env and keep that file private.
IMV_ACTOR_BASE_URL=https://api.deepseek.com
IMV_ACTOR_MODEL=deepseek-flash
IMV_ACTOR_API_KEY=
IMV_VISION_MODEL=deepseek-flash
# Vision URL/key default to the actor's; set separately only for a different provider.
IMV_DISABLE_THINKING=true
# Temporarily record usage without enforcing total/role token or call quotas.
IMV_ENFORCE_MODEL_BUDGET=false
# Per-response output cap remains active; quota values apply only when enforcement is true.
IMV_MAX_OUTPUT_TOKENS=32000
IMV_MAX_TOKENS=200000
IMV_MAX_MODEL_CALLS=32
IMV_MODEL_TIMEOUT_SECONDS=240
# Whole-task and isolated-render deadlines remain independent of model request timeouts.
IMV_JOB_TIMEOUT_SECONDS=600
IMV_RENDER_TIMEOUT_SECONDS=180
# Linux renderer executables and managed fonts; adapt these paths to the server host.
IMV_BROWSER_EXECUTABLE=/home/ubuntu/data/wangshuitians/.local/share/imv/chrome-headless-shell-linux64/chrome-headless-shell
IMV_FONT_REGULAR=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
IMV_FONT_BOLD=/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc
IMV_DATA_DIR=.data

# Remotion 配额仅在预算开关开启时生效；纠错和补证次数限制始终保留。
IMV_MAX_REVIEW_RETRIES=2
IMV_MAX_EVIDENCE_RETRIES=1
# Actor 连续无新观察的停止阈值；不受预算开关影响。
IMV_MAX_NO_PROGRESS_TURNS=4
IMV_MAX_JUDGE_CALLS=12
IMV_MAX_JUDGE_TOKENS=60000
IMV_MAX_ACTOR_CALLS=24
IMV_MAX_ACTOR_TOKENS=160000

# 视频合成回调的公网基础地址，例如 ngrok 分配的 HTTPS 地址。
COMPOSITION_PUBLIC_BASE_URL=

# 素材匹配服务：Base URL 可含部署前缀和末尾 /api/v1，不包含查询参数。
SEGMENT_MATCH_BASE_URL=https://matching.example.com
# 完整 Authorization 头，例如 Bearer <token>；无需鉴权时留空。
SEGMENT_MATCH_AUTHORIZATION=

# 上海 IMS 官方 SDK 凭证；可选 SecurityToken 用于临时 STS 凭证。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
MIX_VIDEO_ALIYUN_IMS_REGION_ID=cn-shanghai
MIX_VIDEO_ALIYUN_IMS_ENDPOINT=ice.cn-shanghai.aliyuncs.com

# 新合成视频转存 ZOS；仅该任务对象设为 public-read，地址须支持匿名读取。
ZOS_API_ENDPOINT=https://hangzhou7.zos.ctyun.cn
ZOS_BUCKET=
ZOS_ACCESS_KEY_ID=
ZOS_SECRET_ACCESS_KEY=
ZOS_WEB_URL=
ZOS_REGION=hangzhou-7
ZOS_FORCE_PATH_STYLE=false
