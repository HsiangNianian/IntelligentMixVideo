# MySQL 连接；pydantic-settings 自动读取，进程环境变量优先于本文件。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_me
DB_NAME=intelligent_mix_video

# 北京地域 Fun-ASR 密钥；模块加载时读取一次，进程环境变量优先。
DASHSCOPE_API_KEY=

# OpenAI 兼容模型服务；从 server/ 启动时读取此 .env，填写自己的 Key
IMV_LLM_BASE_URL=https://example.com/v1
IMV_LLM_API_KEY=
IMV_LLM_MODEL=
IMV_LLM_TIMEOUT_SECONDS=120
IMV_LLM_MAX_RETRIES=1
IMV_ALLOW_INSECURE_LLM_HTTP=false
IMV_SEGMENT_MIN_DURATION_MS=1200
IMV_SEGMENT_MAX_DURATION_MS=6000
IMV_SEGMENT_MAX_KEYWORDS=5
IMV_SEGMENT_KEYWORD_MAX_LENGTH=12
IMV_SEGMENT_MAX_ALIGNMENT_WORK=250000

# Local template agent credentials; copy to server/.env and keep that file private.
IMV_ACTOR_BASE_URL=https://api.deepseek.com
IMV_ACTOR_MODEL=deepseek-flash
IMV_ACTOR_API_KEY=
IMV_VISION_MODEL=deepseek-flash
# Vision URL/key default to the actor's; set separately only for a different provider.
IMV_DISABLE_THINKING=true
# Model budgets shared by planning, review, generation and repairs; timeouts in seconds.
IMV_MAX_OUTPUT_TOKENS=32000
IMV_MAX_TOKENS=200000
IMV_MAX_MODEL_CALLS=32
IMV_MODEL_TIMEOUT_SECONDS=240
# Whole-task and isolated-render deadlines remain independent of model request timeouts.
IMV_JOB_TIMEOUT_SECONDS=600
IMV_RENDER_TIMEOUT_SECONDS=180
# Linux renderer executables and managed fonts; adapt these paths to the server host.
IMV_BROWSER_EXECUTABLE=/opt/google/chrome/chrome
IMV_FONT_REGULAR=/usr/share/fonts/noto-cjk/NotoSansCJK-Regular.ttc
IMV_FONT_BOLD=/usr/share/fonts/noto-cjk/NotoSansCJK-Bold.ttc
IMV_DATA_DIR=.data

# Remotion 各阶段预算共享总上限；纠错和补证有单独次数限制。
IMV_MAX_REVIEW_RETRIES=2
IMV_MAX_EVIDENCE_RETRIES=1
# Actor 连续无新观察的停止阈值；理解需求与代码修复共用执行预算。
IMV_MAX_NO_PROGRESS_TURNS=4
IMV_MAX_JUDGE_CALLS=12
IMV_MAX_JUDGE_TOKENS=60000
IMV_MAX_ACTOR_CALLS=24
IMV_MAX_ACTOR_TOKENS=160000
